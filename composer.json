{
    "name": "contentguard/contentguard",
    "description": "Content quality-control rules for ACF-backed WordPress content.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "ContentGuard\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ContentGuard\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
